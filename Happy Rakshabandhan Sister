<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Aaradhya ❤️</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial,sans-serif;
  overflow:hidden;
  color:white;
  background:#14001d;
}

.slider{
  width:100vw;
  height:100vh;
  position:relative;
}

.slide{
  position:absolute;
  inset:0;
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:25px;
  opacity:0;
  transform:scale(1.1);
  pointer-events:none;
  transition:opacity .8s ease,transform .8s ease;
}

.slide.active{
  opacity:1;
  transform:scale(1);
  pointer-events:auto;
}

.s1{background:linear-gradient(135deg,#5e005e,#ff4f9a)}
.s2{background:linear-gradient(135deg,#13005c,#8b5cf6)}
.s3{background:linear-gradient(135deg,#40001f,#ff4081)}
.s4{background:linear-gradient(135deg,#002b36,#00a6a6)}
.s5{background:linear-gradient(135deg,#451a03,#f97316)}
.s6{background:linear-gradient(135deg,#240046,#c026d3)}
.s7{background:linear-gradient(135deg,#052e16,#16a34a)}
.s8{background:linear-gradient(135deg,#172554,#2563eb)}
.s9{background:linear-gradient(135deg,#3b0764,#e879f9)}
.s10{background:linear-gradient(135deg,#431407,#fb7185)}
.s11{background:linear-gradient(135deg,#020617,#6366f1)}
.s12{background:linear-gradient(135deg,#500724,#ec4899)}

.content{
  width:100%;
  max-width:550px;
}

.emoji{
  font-size:75px;
  animation:float 2s infinite ease-in-out;
  margin-bottom:15px;
}

h1{
  font-size:42px;
  margin:12px 0;
}

h2{
  font-size:29px;
  margin-bottom:18px;
}

p{
  font-size:17px;
  line-height:1.7;
  margin:12px 0;
}

.name{
  font-size:48px;
  font-weight:bold;
  background:linear-gradient(90deg,#fff,#ffd1ec,#fff);
  -webkit-background-clip:text;
  color:transparent;
  animation:shine 2s infinite;
}

button{
  border:0;
  border-radius:50px;
  padding:15px 25px;
  margin-top:22px;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
  background:white;
  color:#710044;
  box-shadow:0 8px 25px rgba(0,0,0,.3);
}

button:active{
  transform:scale(.94);
}

/* Rakhi */

.rakhi{
  width:155px;
  height:155px;
  margin:25px auto;
  border-radius:50%;
  background:
  radial-gradient(circle,
  #fff 0 8%,
  #ffd700 9% 18%,
  #ff4f9a 19% 40%,
  #9333ea 41% 60%,
  transparent 61%);
  box-shadow:0 0 45px #ff9bd5;
  animation:spin 8s linear infinite;
}

/* Cards */

.cards{
  display:grid;
  gap:12px;
}

.card{
  padding:16px;
  border-radius:18px;
  background:rgba(255,255,255,.14);
  border:1px solid rgba(255,255,255,.25);
  backdrop-filter:blur(8px);
}

/* Photos */

.photos{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:20px;
}

.photo{
  height:130px;
  border-radius:20px;
  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.25);
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:40px;
  overflow:hidden;
}

.photo img{
  width:100%;
  height:100%;
  object-fit:cover;
}

/* Countdown */

.count{
  font-size:70px;
  font-weight:bold;
  margin:20px;
}

/* Secret box */

.secret{
  padding:28px;
  border-radius:25px;
  background:rgba(255,255,255,.13);
  border:1px solid rgba(255,255,255,.25);
  backdrop-filter:blur(10px);
}

/* Navigation */

.progress{
  position:fixed;
  top:0;
  left:0;
  height:4px;
  background:white;
  z-index:999;
  transition:.5s;
}

.dots{
  position:fixed;
  bottom:22px;
  left:0;
  width:100%;
  display:flex;
  justify-content:center;
  gap:6px;
  z-index:999;
}

.dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:rgba(255,255,255,.4);
}

.dot.active{
  width:24px;
  border-radius:20px;
  background:white;
}

.next{
  position:fixed;
  right:18px;
  bottom:48px;
  width:50px;
  height:50px;
  padding:0;
  z-index:1000;
  font-size:20px;
}

/* Floating hearts */

.heart{
  position:fixed;
  bottom:-40px;
  font-size:25px;
  pointer-events:none;
  z-index:2000;
  animation:rise 5s linear forwards;
}

/* Confetti */

.confetti{
  position:fixed;
  top:-15px;
  width:9px;
  height:9px;
  z-index:2000;
  animation:fall 3s linear forwards;
}

@keyframes float{
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-15px)}
}

@keyframes spin{
  to{transform:rotate(360deg)}
}

@keyframes shine{
  50%{filter:brightness(1.6)}
}

@keyframes rise{
  to{
    transform:translateY(-110vh) rotate(360deg);
    opacity:0;
  }
}

@keyframes fall{
  to{
    transform:translateY(110vh) rotate(720deg);
    opacity:0;
  }
}

@media(max-width:400px){
  h1{font-size:34px}
  h2{font-size:25px}
  p{font-size:15px}
  .name{font-size:39px}
}
</style>
</head>

<body>

<div class="progress" id="progress"></div>

<div class="slider">


